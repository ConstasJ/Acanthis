{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "lint": {
            "dependsOn": []
        },
        "test": {
            "dependsOn": [],
            "inputs": ["**/*.test.ts", "**/*.test.tsx", "vitest.config.ts"]
        },
        "dev": {
            "persistent": true,
            "cache": false
        }
    }
}