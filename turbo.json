{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"test": {
			"dependsOn": [],
			"inputs": ["**/*.test.ts", "**/*.test.tsx", "vitest.config.ts"]
		},
		"check-types": {
			"dependsOn": [],
			"inputs": ["**/*.ts", "**/*.tsx", "!**/*.test.ts", "!**/*.test.tsx"]
		},
		"//#format-and-lint": {},
		"//#format-and-lint:fix": {
			"cache": false
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
