{
	"name": "@acanthis-dec/workspace",
	"version": "0.0.1",
	"private": true,
	"description": "The workspace root of Acanthis project",
	"author": "ConstasJ <constasj@qq.com>",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"release": "pnpm run build && changeset publish",
		"build:affected": "turbo run build --affected",
		"check-types:affected": "turbo run check-types --affected",
		"test:affected": "turbo run test --affected",
		"format-and-lint": "biome check .",
		"format-and-lint:fix": "biome check . --write",
		"lint": "turbo run //#format-and-lint",
		"lint:fix": "turbo run //#format-and-lint:fix"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ConstasJ/Acanthis.git"
	},
	"homepage": "https://github.com/ConstasJ/Acanthis#readme",
	"bugs": {
		"url": "https://github.com/ConstasJ/Acanthis/issues"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@changesets/cli": "^3.0.1",
		"turbo": "^2.10.12"
	}
}
