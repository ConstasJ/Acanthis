{
	"name": "@acanthis-dec/linovelib",
	"version": "0.0.1",
	"description": "An Acanthis adapter for Linovelib site.",
	"author": "ConstasJ <constasj@qq.com>",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.6.0",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
