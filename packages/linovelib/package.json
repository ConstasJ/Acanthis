{
	"name": "@acanthis-dec/linovelib",
	"version": "1.0.0",
	"description": "An Acanthis adapter for Linovelib site.",
	"author": "ConstasJ <constasj@qq.com>",
	"license": "MIT",
	"type": "module",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"onFail": "download"
		}
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"package.json",
		"README.md",
		"README.zh-CN.md"
	],
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ConstasJ/Acanthis.git"
	},
	"homepage": "https://github.com/ConstasJ/Acanthis#readme",
	"bugs": {
		"url": "https://github.com/ConstasJ/Acanthis/issues"
	},
	"dependencies": {
		"@acanthis-dec/browser-fetch": "workspace:*",
		"@acanthis-dec/core": "workspace:*",
		"@acanthis-dec/deobfuscator": "workspace:*",
		"@acanthis-dec/storage": "workspace:*",
		"@babel/parser": "^7.29.7",
		"@babel/traverse": "^7.29.7",
		"@babel/types": "^7.29.7",
		"cheerio": "^1.2.0",
		"deepmerge-ts": "^7.1.5",
		"p-queue": "^9.3.0",
		"zod": "^4.4.3",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@acanthis-dec/config-tsdown": "workspace:*",
		"@acanthis-dec/config-typescript": "workspace:*",
		"@types/babel__traverse": "^7.28.0",
		"@types/node": "catalog:",
		"domhandler": "^6.0.1",
		"tsdown": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	},
	"publishConfig": {
		"types": "./src/index.d.mts",
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"types": "./dist/index.d.mts"
			}
		}
	}
}
