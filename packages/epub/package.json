{
	"name": "@acanthis-dec/epub",
	"version": "0.0.0",
	"description": "Platform-independent in-memory EPUB 3.0 builder for Acanthis.",
	"author": "ConstasJ <constasj@qq.com>",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"package.json",
		"README.md",
		"README.zh-CN.md"
	],
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ConstasJ/Acanthis.git"
	},
	"homepage": "https://github.com/ConstasJ/Acanthis#readme",
	"bugs": {
		"url": "https://github.com/ConstasJ/Acanthis/issues"
	},
	"dependencies": {
		"dom-serializer": "^2.0.0",
		"domhandler": "^6.0.1",
		"fflate": "^0.8.3",
		"htmlparser2": "^10.1.0"
	},
	"devDependencies": {
		"@acanthis-dec/config-tsdown": "workspace:*",
		"@acanthis-dec/config-typescript": "workspace:*",
		"tsdown": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	},
	"publishConfig": {
		"types": "./dist/index.d.mts",
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"types": "./dist/index.d.mts"
			}
		}
	}
}
