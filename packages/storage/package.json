{
	"name": "@acanthis-dec/storage",
	"version": "1.0.4",
	"description": "The storage module of Athanthis project, providing abilities of local cache and persistent configs.",
	"author": "ConstasJ <constasj@qq.com>",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.7.0",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"package.json",
		"README.md",
		"README.zh-CN.md"
	],
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ConstasJ/Acanthis.git"
	},
	"homepage": "https://github.com/ConstasJ/Acanthis#readme",
	"bugs": {
		"url": "https://github.com/ConstasJ/Acanthis/issues"
	},
	"dependencies": {
		"@acanthis-dec/browser-fetch": "workspace:*",
		"@acanthis-dec/core": "workspace:*",
		"@libsql/client": "^0.17.3",
		"drizzle-orm": "rc",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@acanthis-dec/config-tsdown": "workspace:*",
		"@acanthis-dec/config-typescript": "workspace:*",
		"@types/node": "catalog:",
		"drizzle-kit": "rc",
		"tsdown": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	},
	"publishConfig": {
		"types": "./dist/index.d.mts",
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"types": "./dist/index.d.mts"
			}
		}
	}
}
