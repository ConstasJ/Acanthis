{
	"name": "@acanthis-dec/deobfuscator",
	"version": "1.0.0",
	"description": "A package of Acanthis project that provide ability to detect obfuscated JavaScript code and deobfuscate it.",
	"author": "ConstasJ <constasj@qq.com>",
	"license": "MIT",
	"type": "module",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"onFail": "download"
		}
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"package.json",
		"README.md",
		"README.zh-CN.md"
	],
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ConstasJ/Acanthis.git"
	},
	"homepage": "https://github.com/ConstasJ/Acanthis#readme",
	"bugs": {
		"url": "https://github.com/ConstasJ/Acanthis/issues"
	},
	"dependencies": {
		"webcrack": "2.16.0"
	},
	"devDependencies": {
		"@acanthis-dec/config-tsdown": "workspace:*",
		"@acanthis-dec/config-typescript": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	},
	"publishConfig": {
		"types": "./src/index.d.mts",
		"exports": {
			".": {
				"import": "./dist/index.mjs",
				"types": "./dist/index.d.mts"
			}
		}
	}
}
