{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@acanthis-dec/config-typescript/apps.json",
	"compilerOptions": {
		"types": ["vite/client"],
		"jsx": "preserve",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts"]
}
